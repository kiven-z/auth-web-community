    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "axios": "^1.20.0",
    "cropperjs": "^1.7.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "js-cookie": "^3.0.8",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "markdown-it-github-alerts": "^1.0.1",
    "md-editor-v3": "^7.1.0",
    "mermaid": "^12.1.0",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "monaco-editor-vue3": "^1.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "qs": "^6.16.0",
    "sortablejs": "^1.15.7",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vue": "^3.5.43",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.4.14",
    "vue-picture-cropper": "^1.0.0",
