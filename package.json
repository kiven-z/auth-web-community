{
  "name": "auth-web-community",
  "version": "1.0.0-rc.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "dev:test": "NODE_OPTIONS=--max-old-space-size=4096 vite --mode test",
    "serve": "pnpm dev",
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "svgo": "svgo -f . -r",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "PLAYWRIGHT_CHANNEL=chrome playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "generate:icon-catalog": "node scripts/generate-icon-catalog.mjs",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "element-plus",
    "tailwindcss",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "homepage": "https://github.com/kiven-z/auth-web-community",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiven-z/auth-web-community.git"
  },
  "bugs": {
    "url": "https://github.com/kiven-z/auth-web-community/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Bunny",
    "email": "1319900154@qq.com",
    "url": "https://github.com/kiven-z"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "axios": "^1.12.2",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.5",
    "js-cookie": "^3.0.5",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "markdown-it-github-alerts": "^1.0.1",
    "md-editor-v3": "^6.5.3",
    "mermaid": "^11.16.1",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "monaco-editor-vue3": "^1.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.3",
    "qs": "^6.14.0",
    "sortablejs": "^1.15.6",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vue": "^3.5.22",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.1.12",
    "vue-picture-cropper": "^1.0.0",
    "vue-router": "^4.6.3",
    "vue-tippy": "^6.7.1",
    "vue-types": "^6.0.0",
