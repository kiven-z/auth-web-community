# 全环境共用（Vite 任意 mode 都会加载）

# 本地开发端口（占用时 Vite 会自行换口）
VITE_PORT = 5173

# 是否隐藏首页：true 隐藏，false 不隐藏
VITE_HIDE_HOME = false

# 静态资源公共路径（与 Vue Router base 一致，见 import.meta.env.BASE_URL）
VITE_PUBLIC_PATH = /

# 本地开发 API 代理（pnpm dev）；Docker 生产由 nginx 反代，不依赖此项
VITE_PROXY_TARGET = http://localhost:8080

# 打包时是否用 CDN 替换本地库（公网/大包场景可开；内网部署保持 false）
VITE_CDN = false

# gzip / brotli：gzip、brotli、both、none（及对应 *-clear）
# 开启后需配合 docker nginx 的 gzip_static，才会直接下发预压缩文件
VITE_COMPRESSION = "none"
